{
  "expo": {
    "name": "نبـــأ - NABA",
    "slug": "naba",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "naba",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.naba",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anonymous.naba",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#050505"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/naba-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "c0514cd4-df78-4adc-b0ca-88f76ae4a762"
      }
    },
    "owner": "yusef_1442"
  }
}
